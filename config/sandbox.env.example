# Update whenever the sandbox is renewed. Never commit the real sandbox.env.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1

# Create the Connect instance manually, then fill in its current values.
CONNECT_INSTANCE_ID=
CONNECT_INSTANCE_ALIAS=
CONNECT_ACCESS_URL=
CONNECT_ADMIN_USERNAME=
CONNECT_ADMIN_PASSWORD=

# Optional: record the instance storage destinations when needed by a practice.
CONNECT_S3_BUCKET=
CONNECT_S3_PREFIX=
CONNECT_LOG_GROUP=

# ACXD programmatic user key for workspace exports (not the backend API_Key).
ACXD_API_KEY=
# Optional default; --workspace-id can select a different workspace per practice.
ACXD_WORKSPACE_ID=
