{
  "flowId": "Entry",
  "aiDescription": "Authentication flow for AnyBank. Verifies the caller by capturing their customer ID against the enumerated set of valid identifiers, copies the verified value into the customerId context variable, and hands off to the Main flow. Re-entry with an already-verified caller skips straight to Main. A no-match repairs and retries up to three tries, then escalates to a person.",
  "untrained": true,
  "mainLanguageCode": "en-US",
  "languageCodes": [
    "en-US"
  ],
  "slotTypes": [
    {
      "name": "CustomerID",
      "sensitive": false,
      "type": "customerId",
      "examples": [
        "My customer ID is CUST-12345",
        "customer CUST-67890",
        "it's CUST-11111",
        "CUST-12345",
        "cust-67890"
      ],
      "aiDescription": "The caller's customer identifier, in the shape CUST-00000. Extract it from the caller's phrase and resolve it against the enumerated set of valid customer identifiers, which canonicalises the casing."
    }
  ],
