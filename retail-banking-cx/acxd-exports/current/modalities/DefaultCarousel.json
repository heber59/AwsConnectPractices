{
  "modalityId": "DefaultCarousel",
  "schema": {
    "type": "object",
    "properties": {
      "cards": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "title": "ID"
            },
            "thumbnail": {
              "type": "string",
              "title": "Thumbnail URL",
              "description": "The URL of the thumbnail image. Leaving it blank will cause the card to not have an image."
            },
            "thumbnailAlt": {
              "type": "string",
              "title": "Thumbnail alt",
              "description": "Provide a description of the image."
            },
            "rows": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "title": "Label"
                  },
                  "value": {
                    "type": "string",
                    "title": "Value"
                  }
                },
                "title": "Row"
              },
              "required": [
                "label",
                "value"
              ],
              "title": "Rows"
            }
          },
          "title": "Card"
        },
        "required": [
          "id",
          "rows"
        ]
      },
      "$saveAs": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "The type of data sent to the application on selection"
          },
          "id": {
            "type": "string",
            "description": "The ID of the selection, e.g. slot or context variable name"
          }
        },
        "description": "Defines how selecting UI elements in the rendered modality should be registered by the application, e.g. sending a slot, choice or context attribute value."
      }
    }
  },
  "metadata": {
    "path": "Pre-defined",
    "tags": []
  }
}
