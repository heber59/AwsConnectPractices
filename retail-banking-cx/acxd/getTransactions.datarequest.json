{
  "dataRequestId": "getTransactions",
  "webhook": {
    "version": "v3",
    "sendContext": true,
    "implementation": "external",
    "method": "GET",
    "environments": {
      "production": {
        "url": "{API_URL_Base:NLX.Secret}/retail-banking/transactions?accountId={accountId}",
        "headers": [
          {
            "key": "x-api-key",
            "value": "{API_Key:NLX.Secret}",
            "dynamic": false,
            "required": false
          }
        ]
      }
    }
  },
  "description": "Posted transactions for one account (accountId CHK-000 or SAV-000, from getAccounts). There is no date filter: the whole history comes back.",
  "sensitive": false,
  "streamStateModifications": false,
  "tags": [],
  "path": ""
}
