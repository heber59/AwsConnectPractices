{
  "dataRequestId": "transferFunds",
  "webhook": {
    "version": "v3",
    "sendContext": true,
    "implementation": "external",
    "method": "POST",
    "environments": {
      "production": {
        "url": "{API_URL_Base:NLX.Secret}/retail-banking/transfers?customerId={customerId}&fromAccountId={fromAccountId}&toAccountId={toAccountId}&amount={amount}&memo={memo}",
        "headers": [
          {
            "key": "x-api-key",
            "value": "{API_Key:NLX.Secret}",
            "dynamic": false,
            "required": false
          }
        ]
      }
    }
  },
  "description": "Move money between the caller's own accounts (two different ids from getAccounts). amount in dollars; memo is required. Check availableBalance; confirm from, to and amount first.",
  "sensitive": false,
  "streamStateModifications": true,
  "tags": [],
  "path": ""
}
